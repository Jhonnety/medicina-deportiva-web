{
  "celulas-madre-mesenquimales": {
    "es": {
      "title": "Células Madre Mesenquimales",
      "subtitle": "Regeneración total con células totipotenciales",
      "metaTitle": "Células Madre Mesenquimales en Medellín | Dr. James Madrid",
      "metaDescription": "Tratamiento con células madre mesenquimales para regeneración de tejidos. Terapia avanzada autóloga o alogénica. +20 años de experiencia.",
      "whatIs": {
        "title": "¿Qué son las Células Madre Mesenquimales y cómo funcionan?",
        "definition": "Las células madre mesenquimales son células totipotenciales con la capacidad única de diferenciarse en diversos tipos de tejidos. Tienen la capacidad de convertir tejido enfermo en tejido sano mediante procesos de regeneración natural.",
        "physiologicalBenefit": "Estas células estimulan la reparación y regeneración de tejidos dañados, reducen la inflamación, modulan el sistema inmunológico y promueven la formación de nuevos vasos sanguíneos. Son especialmente efectivas en lesiones articulares, tendinosas y degenerativas.",
        "howWorks": "El procedimiento consiste en la extracción, procesamiento y aplicación de células madre, ya sea autólogas (del mismo paciente) o alogénicas (de donante compatible). Estas células se aplican directamente en la zona afectada guiadas por ultrasonido para máxima precisión."
      },
      "symptoms": {
        "title": "Condiciones que Tratamos",
        "list": [
          "Artrosis avanzada",
          "Lesiones de cartílago articular",
          "Tendinopatías crónicas",
          "Lesiones meniscales",
          "Daño del manguito rotador",
          "Lesiones ligamentarias crónicas"
        ]
      },
      "results": {
        "title": "Resultados que Puedes Esperar",
        "items": [
          {
            "title": "Regeneración Tisular",
            "description": "Formación de nuevo tejido sano en áreas dañadas en 3-6 meses.",
            "percentage": "85%"
          },
          {
            "title": "Reducción del Dolor",
            "description": "Alivio significativo del dolor crónico en las primeras 4-8 semanas.",
            "percentage": "90%"
          },
          {
            "title": "Mejora Funcional",
            "description": "Recuperación de la movilidad y función normal de la articulación.",
            "percentage": "88%"
          }
        ]
      },
      "process": {
        "title": "Tu Tratamiento en 3 Pasos",
        "steps": [
          {
            "number": "01",
            "title": "Evaluación y Extracción",
            "description": "Evaluación completa de tu condición. Si se opta por células autólogas, se realiza la extracción mediante punción de médula ósea o tejido adiposo bajo anestesia local."
          },
          {
            "number": "02",
            "title": "Procesamiento en Laboratorio",
            "description": "Las células se procesan en laboratorio especializado para aislar, concentrar y expandir las células madre mesenquimales bajo estrictos controles de calidad."
          },
          {
            "number": "03",
            "title": "Aplicación y Seguimiento",
            "description": "Aplicación guiada por ultrasonido en la zona afectada. Seguimiento continuo con controles periódicos para evaluar la regeneración y ajustar el tratamiento según necesidad."
          }
        ]
      },
      "faqs": [
        {
          "q": "¿Cuánto tiempo dura el tratamiento completo?",
          "a": "El proceso completo desde la extracción hasta la aplicación puede tomar entre 3-4 semanas. Los resultados comienzan a notarse entre 4-8 semanas y continúan mejorando hasta los 6 meses."
        },
        {
          "q": "¿Es doloroso el procedimiento?",
          "a": "Tanto la extracción como la aplicación se realizan con anestesia local. La molestia es mínima y se maneja adecuadamente con analgésicos comunes durante los primeros días."
        },
        {
          "q": "¿Cuál es la diferencia entre células autólogas y alogénicas?",
          "a": "Las células autólogas provienen del mismo paciente, eliminando riesgo de rechazo. Las alogénicas provienen de donante compatible y están disponibles inmediatamente. Ambas son efectivas y la elección depende de cada caso."
        }
      ]
    },
    "en": {
      "title": "Mesenchymal Stem Cells",
      "subtitle": "Total regeneration with totipotential cells",
      "metaTitle": "Mesenchymal Stem Cells in Medellín | Dr. James Madrid",
      "metaDescription": "Treatment with mesenchymal stem cells for tissue regeneration. Advanced autologous or allogeneic therapy. +20 years of experience.",
      "whatIs": {
        "title": "What are Mesenchymal Stem Cells and how do they work?",
        "definition": "Mesenchymal stem cells are totipotential cells with the unique ability to differentiate into various types of tissues. They have the capacity to convert diseased tissue into healthy tissue through natural regeneration processes.",
        "physiologicalBenefit": "These cells stimulate the repair and regeneration of damaged tissues, reduce inflammation, modulate the immune system, and promote the formation of new blood vessels. They are especially effective in joint, tendon, and degenerative injuries.",
        "howWorks": "The procedure consists of extraction, processing, and application of stem cells, either autologous (from the same patient) or allogeneic (from a compatible donor). These cells are applied directly to the affected area guided by ultrasound for maximum precision."
      },
      "symptoms": {
        "title": "Conditions We Treat",
        "list": [
          "Advanced osteoarthritis",
          "Articular cartilage injuries",
          "Chronic tendinopathies",
          "Meniscal injuries",
          "Rotator cuff damage",
          "Chronic ligament injuries"
        ]
      },
      "results": {
        "title": "Results You Can Expect",
        "items": [
          {
            "title": "Tissue Regeneration",
            "description": "Formation of new healthy tissue in damaged areas in 3-6 months.",
            "percentage": "85%"
          },
          {
            "title": "Pain Reduction",
            "description": "Significant relief from chronic pain in the first 4-8 weeks.",
            "percentage": "90%"
          },
          {
            "title": "Functional Improvement",
            "description": "Recovery of mobility and normal joint function.",
            "percentage": "88%"
          }
        ]
      },
      "process": {
        "title": "Your Treatment in 3 Steps",
        "steps": [
          {
            "number": "01",
            "title": "Evaluation and Extraction",
            "description": "Complete evaluation of your condition. If autologous cells are chosen, extraction is performed by bone marrow or adipose tissue puncture under local anesthesia."
          },
          {
            "number": "02",
            "title": "Laboratory Processing",
            "description": "Cells are processed in a specialized laboratory to isolate, concentrate, and expand mesenchymal stem cells under strict quality controls."
          },
          {
            "number": "03",
            "title": "Application and Follow-up",
            "description": "Ultrasound-guided application to the affected area. Continuous follow-up with periodic controls to evaluate regeneration and adjust treatment as needed."
          }
        ]
      },
      "faqs": [
        {
          "q": "How long does the complete treatment take?",
          "a": "The complete process from extraction to application can take 3-4 weeks. Results begin to be noticed between 4-8 weeks and continue to improve up to 6 months."
        },
        {
          "q": "Is the procedure painful?",
          "a": "Both extraction and application are performed with local anesthesia. Discomfort is minimal and is adequately managed with common analgesics during the first days."
        },
        {
          "q": "What is the difference between autologous and allogeneic cells?",
          "a": "Autologous cells come from the same patient, eliminating rejection risk. Allogeneic cells come from a compatible donor and are immediately available. Both are effective and the choice depends on each case."
        }
      ]
    }
  },
